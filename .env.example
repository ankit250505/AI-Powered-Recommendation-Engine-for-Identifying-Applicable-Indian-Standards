APP_ENV=production
APP_PORT=8000
DATABASE_PATH=app_data/recommendations.db
SESSION_HOURS=8
# Set true when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
TRUSTED_HOSTS=localhost,127.0.0.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set true after the model has been cached in the deployment volume.
EMBEDDING_LOCAL_ONLY=false
LOGIN_ATTEMPT_LIMIT=5
LOGIN_WINDOW_SECONDS=300
